# ---- Python / backend ----
backend/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Node / frontend ----
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
*.tsbuildinfo
next-env.d.ts

# ---- Env / secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Data / generated ----
data/raw/
data/processed/
*.log
# Dev-server / uvicorn output. Redirected to .out as well as .log in places, so ignore
# the directories outright rather than chasing suffixes.
logs/

# Database backups (pg_dump output, tens of MB, never source)
backups/

# ---- User-supplied source workbooks ----
# Year folders dropped into the repo root (e.g. 2026/) hold official PDFs/XLS that must
# not be redistributed from a public repository. Import them with
# `python -m app.ingestion.etl_2026 --data-root <dir>`; they stay out of git.
/20[0-9][0-9]/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Generated analysis output (regenerate with backend/app/ingestion/snapshot_run.py) ----
docs/real-run.json
docs/_preview*/

# local-only helper (environment-specific network workaround)
scripts/push_via_api.py

# 设计稿用的真实样本数据（由 scripts/dump_design_sample.py 生成，可随时重跑）
docs/design/_sample-data.json

backend/build/
staging/
desktop/node_modules/
desktop/release/
backend/dist/
