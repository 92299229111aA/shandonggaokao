# ---- Copy to .env for local development (docker compose reads this file) ----
# NEVER commit real secrets. This file contains placeholders only.

# ---------- PostgreSQL ----------
POSTGRES_USER=gaokao
POSTGRES_PASSWORD=gaokao_dev_only
POSTGRES_DB=gaokao
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-side port exposed by docker compose (change if 5433 is taken)
POSTGRES_HOST_PORT=5433

# ---------- Backend (FastAPI) ----------
# SQLAlchemy URL used when the API runs directly on the host.
#  - docker compose publishes PostgreSQL on 127.0.0.1:${POSTGRES_HOST_PORT}
#  - `make db-up-wsl` (WSL-native PostgreSQL) uses port 5432
#  - a machine-local PostgreSQL install uses 5432
DATABASE_URL=postgresql+psycopg://gaokao:gaokao_dev_only@127.0.0.1:5433/gaokao
# URL used by the backend container
DATABASE_URL_DOCKER=postgresql+psycopg://gaokao:gaokao_dev_only@db:5432/gaokao
# Dedicated database for integration tests (created/dropped by the test fixtures)
TEST_DATABASE_URL=postgresql+psycopg://gaokao:gaokao_dev_only@127.0.0.1:5433/gaokao_test

REDIS_URL=redis://127.0.0.1:6380/0
REDIS_URL_DOCKER=redis://cache:6379/0
# Host-side Redis port exposed by docker compose
REDIS_HOST_PORT=6380

API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Frontend (Next.js) ----------
# Points at the backend as seen *from the browser*
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_HOST_PORT=3000
